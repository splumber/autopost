# Copy this file to .env and fill in real values. Never commit .env.

# --- Local LLM proxy (OpenAI-compatible; routes to your local Ollama/model proxy) ---
AUTOPOST_LLM_BASE_URL=http://localhost:20128/v1
AUTOPOST_LLM_API_KEY=unused

# --- Stock footage/photo providers (free tier API keys) ---
AUTOPOST_PEXELS_API_KEY=
AUTOPOST_PIXABAY_API_KEY=

# --- TikTok developer app (from developers.tiktok.com, see docs/SETUP_CHECKLIST.md) ---
AUTOPOST_TIKTOK_CLIENT_KEY=
AUTOPOST_TIKTOK_CLIENT_SECRET=

# --- Token encryption at rest. Generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOPOST_SECRET_KEY=

# --- Optional dashboard basic auth (recommended once exposed beyond localhost) ---
AUTOPOST_WEB_BASIC_AUTH_USERNAME=
AUTOPOST_WEB_BASIC_AUTH_PASSWORD=
